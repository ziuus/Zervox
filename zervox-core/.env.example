# Zervox Core Configuration
ZERVOX_ROLE=primary
ZERVOX_HTTP_PORT=8080
ZERVOX_HEARTBEAT_PORT=9000
ZERVOX_PEER=127.0.0.1:9000
ZERVOX_API_KEY=zervox-secret-token
ZERVOX_DB_PATH=zervox.db
OPA_URL=http://127.0.0.1:8181/v1/data/zervox/authz

# Optional LLM Analysis Configuration
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
ZERVOX_FORCE_FALLBACK=false
ZERVOX_DRY_RUN=false

# Kubernetes Configuration (defaults to in-cluster or ~/.kube/config)
# KUBECONFIG=/path/to/k3s.yaml
