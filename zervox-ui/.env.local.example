# Zervox UI Environment Configuration
# Copy this to .env.local for local development

# Primary Zervox instance URL (used by Next.js API proxy)
ZERVOX_PRIMARY_URL=http://localhost:8080

# Backup Zervox instance URL
ZERVOX_BACKUP_URL=http://localhost:8081

# API key for webhook auth (read-only status endpoints don't require it)
ZERVOX_API_KEY=zervox-secret-token

# Poll interval for status updates (milliseconds)
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# URLs accessible from the BROWSER (client-side polling)
NEXT_PUBLIC_PRIMARY_URL=http://localhost:8080
NEXT_PUBLIC_BACKUP_URL=http://localhost:8081
